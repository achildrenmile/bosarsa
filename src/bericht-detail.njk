---
layout: base.njk
activeNav: presse
pageCSSFile: "/css/termine.css"
pagination:
  data: berichte
  size: 1
  alias: bericht
permalink: "/bericht/{{ bericht.slug }}/"
eleventyComputed:
  title: "{{ bericht.title }} — BOS-ARSA"
  description: "{{ bericht.intro }}"
  canonical: "https://bosarsa.oeradio.at/bericht/{{ bericht.slug }}/"
  robots: "{{ 'noindex, nofollow' if bericht.draft else 'index, follow' }}"
  ogImage: "{{ bericht.image }}"
  ogImageAlt: "{{ bericht.imageAlt }}"
---

<div class="page-content page-content--wide">
  {% if bericht.draft %}<div class="draft-ribbon" role="note"><span class="draft-ribbon__tag">Entwurf</span> Nicht öffentlich, nur über diesen Link erreichbar.</div>{% endif %}
  <p class="back-link"><a href="/presse/">← Presse &amp; Medien</a></p>

  <article class="event">
    {% if bericht.image %}
    <div class="event__image">
      <img src="{{ bericht.image }}" alt="{{ bericht.imageAlt }}" loading="lazy">
      {% if bericht.imageCredit %}<span class="article__image-credit">Foto: {{ bericht.imageCredit }}</span>{% endif %}
    </div>
    {% endif %}
    <div class="event__body">
      <div class="event__meta">
        <span class="event__date">{{ bericht.date }}</span>
        <span class="article__tag article__tag--{{ bericht.tag }}">{{ bericht.tagLabel }}</span>
      </div>
      <h1 class="event__title">{{ bericht.title }}</h1>
      <p class="event__intro">{{ bericht.intro }}</p>

      {% if bericht.facts %}
      <dl class="bericht__facts">
        {% for f in bericht.facts %}<div><dt>{{ f.k }}</dt><dd>{{ f.v }}</dd></div>{% endfor %}
      </dl>
      {% endif %}

      {% for section in bericht.sections %}
      <section class="bericht__section">
      <h3 class="event__heading">{{ section.heading }}</h3>
      {% if section.content is string %}<p class="event__text">{{ section.content }}</p>{% else %}{% for para in section.content %}<p class="event__text">{{ para }}</p>{% endfor %}{% endif %}
      {% if section.figures %}
      <div class="bericht__figures bericht__figures--{{ section.layout or 'grid' }}">
        {% for f in section.figures %}
        <figure class="bericht__figure">
          <img src="{{ f.src }}" alt="{{ f.alt }}" loading="lazy"{% if f.pos %} style="object-position: {{ f.pos }}"{% endif %}>
          <figcaption>{{ f.caption }}{% if f.credit %}<span class="bericht__credit">Foto: {{ f.credit }}</span>{% endif %}</figcaption>
        </figure>
        {% endfor %}
      </div>
      {% endif %}
      </section>
      {% if loop.first and bericht.timeline %}
      <section class="bericht__section bericht__timeline">
        <h3 class="event__heading">Der Ablauf im Überblick</h3>
        {% for d in bericht.timeline %}
        <h4>{{ d.day }}</h4>
        <ul>{% for i in d.items %}<li><time>{{ i.t }}</time> {{ i.e }}</li>{% endfor %}</ul>
        {% endfor %}
      </section>
      {% endif %}
      {% endfor %}

      {% if bericht.author %}
      <p class="event__author">73 de {{ bericht.author }}</p>
      {% endif %}
    </div>
  </article>
</div>
